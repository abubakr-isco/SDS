# Quote form delivery — the first one set wins. Leave both empty for demo mode (nothing is sent).

# Web3Forms access key (https://web3forms.com): quote requests are emailed to the address the key
# was created for. Public by design — it only lets this form email that one address.
VITE_WEB3FORMS_ACCESS_KEY=

# Or: URL that receives quote requests as a JSON POST (the SDS bot's /api/quote).
VITE_QUOTE_ENDPOINT=
