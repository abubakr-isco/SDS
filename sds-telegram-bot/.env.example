# Copy to .env and fill in. NEVER commit .env.

# Telegram bot token from @BotFather (keep secret)
BOT_TOKEN=123456789:replace-with-your-token-from-botfather

# PostgreSQL connection (async driver). With Docker Compose the host is "db".
DATABASE_URL=postgresql+asyncpg://sds_bot:change-me@localhost:5432/sds_bot
# Used by docker-compose.yml to create the database user — must match DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Comma-separated numeric Telegram user IDs of SDS administrators.
# Send /myid to the bot to see yours. Synced into the database at startup.
ADMIN_TELEGRAM_IDS=

# development shows setup warnings for missing content; production hides them.
ENVIRONMENT=production
TIMEZONE=America/Chicago
LOG_LEVEL=INFO
LOG_FORMAT=json

# Delete completed/cancelled requests (and their customers' data) after N days. 0 = keep forever.
DATA_RETENTION_DAYS=730

QUOTE_SESSION_TIMEOUT_MINUTES=60
QUOTE_SUBMISSIONS_PER_HOUR=3
TRACKING_LOOKUPS_PER_10_MINUTES=10
NOTIFICATION_RETRY_INTERVAL_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=10

# Website quote form → POST /api/quote on this server → saved + sent to admins in Telegram.
WEB_ENABLED=true
# 127.0.0.1 behind a reverse proxy (recommended); Docker Compose sets 0.0.0.0 inside the container.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Comma-separated website origins allowed to submit, e.g. https://www.sdsuzinc.com,https://sdsuzinc.com
WEBSITE_ALLOWED_ORIGINS=
# true only when a reverse proxy sets X-Forwarded-For (used for per-IP rate limiting)
WEB_TRUST_PROXY=false
WEBSITE_QUOTES_PER_HOUR_PER_IP=5

# Shipment tracking backend. "none" = not integrated (the bot says so honestly).
TRACKING_PROVIDER=none
